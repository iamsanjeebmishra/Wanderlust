
<% layout('layouts/boilerplate') %>

<style>
  #filters {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: nowrap;
    gap: 1rem;
    width: 100%;
    overflow-x: auto;
  }

  .filter {
    text-align: center;
    margin: 0;
    opacity: 0.75;
    flex-shrink: 0;
    text-decoration: none;
    color: #222;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid transparent;
    transition: all 0.2s ease;
  }

  .filter i {
    color: #fe424d;
  }

  .filter:hover {
    opacity: 1;
    cursor: pointer;
  }

  .filter p {
    margin-bottom: 0;
  }

  .filter.active {
    opacity: 1;
    color: #fe424d;
    border-bottom: 2px solid #fe424d;
    font-weight: 600;
  }

  .tax-info {
    display: none;
  }

  .tax-toggle {
    border: 1px solid #ccc;
    border-radius: 1rem;
    height: 3rem;
    padding: 1rem;
    margin: 0;
    display: flex;
    align-items: center;
    white-space: nowrap;
    flex-shrink: 0;
    margin-bottom: 1rem;
  }
</style>

<div class="container mt-4">

  <!-- Filters -->
  <div id="filters">

    <a href="/listings?category=trending"
       class="filter <%= category === 'trending' ? 'active' : '' %>">
      <i class="fa-solid fa-fire"></i>
      <p>Trending</p>
    </a>

    <a href="/listings?category=rooms"
       class="filter <%= category === 'rooms' ? 'active' : '' %>">
      <i class="fa-solid fa-bed"></i>
      <p>Rooms</p>
    </a>

    <a href="/listings?category=iconic-cities"
       class="filter <%= category === 'iconic-cities' ? 'active' : '' %>">
      <i class="fa-solid fa-mountain-city"></i>
      <p>Iconic Cities</p>
    </a>

    <a href="/listings?category=mountains"
       class="filter <%= category === 'mountains' ? 'active' : '' %>">
      <i class="fa-solid fa-mountain"></i>
      <p>Mountains</p>
    </a>

    <a href="/listings?category=castles"
       class="filter <%= category === 'castles' ? 'active' : '' %>">
      <i class="fa-brands fa-fort-awesome"></i>
      <p>Castles</p>
    </a>

    <a href="/listings?category=pools"
       class="filter <%= category === 'pools' ? 'active' : '' %>">
      <i class="fa-solid fa-person-swimming"></i>
      <p>Awesome Pools</p>
    </a>

    <a href="/listings?category=camping"
       class="filter <%= category === 'camping' ? 'active' : '' %>">
      <i class="fa-solid fa-tents"></i>
      <p>Camping</p>
    </a>

    <a href="/listings?category=nature"
       class="filter <%= category === 'nature' ? 'active' : '' %>">
      <i class="fa-solid fa-tree"></i>
      <p>Nature</p>
    </a>

    <a href="/listings?category=arctic"
       class="filter <%= category === 'arctic' ? 'active' : '' %>">
      <i class="fa-regular fa-snowflake"></i>
      <p>Arctic</p>
    </a>

    <a href="/listings?category=beach"
       class="filter <%= category === 'beach' ? 'active' : '' %>">
      <i class="fa-solid fa-umbrella-beach"></i>
      <p>Beach</p>
    </a>

    <!-- Tax Toggle -->
    <div class="tax-toggle">
      <div class="form-check-reverse form-switch">
        <input
          class="form-check-input"
          type="checkbox"
          role="switch"
          id="flexSwitchCheckDefault"
        >

        <label class="form-check-label" for="flexSwitchCheckDefault">
          Display total after taxes
        </label>
      </div>
    </div>

  </div>

  <!-- Listings -->
  <div class="row mt-3">

    <% if (allListings.length === 0) { %>

      <div class="col-12 text-center mt-5">
        <h4>No listings found!</h4>
        <p>Try another search or category.</p>
        <a href="/listings" class="btn btn-dark">View all listings</a>
      </div>

    <% } %>

    <% for (let listing of allListings) { %>

      <div class="col-md-4 mb-4">

        <a
          href="/listings/<%= listing._id %>"
          class="text-decoration-none text-dark"
        >

          <div class="card h-100">

            <img
              src="<%= listing.image.url %>"
              class="card-img-top"
              alt="listing image"
              style="height: 200px; object-fit: cover;"
            >

            <div class="card-img-overlay"></div>

            <div class="card-body">

              <h5 class="card-title">
                <%= listing.title %>
              </h5>

              <p class="card-text">
                &#8377;
                <%= listing.price == null
                  ? "Price unavailable"
                  : listing.price.toLocaleString("en-IN") %> /night

                <i class="tax-info">&nbsp;+18% GST</i>
              </p>

            </div>

          </div>

        </a>

      </div>

    <% } %>

  </div>

</div>

<script>
  let taxSwitch = document.getElementById("flexSwitchCheckDefault");

  taxSwitch.addEventListener("click", () => {
    let taxInfo = document.getElementsByClassName("tax-info");

    for (info of taxInfo) {
      if (info.style.display === "none" || info.style.display === "") {
        info.style.display = "inline";
      } else {
        info.style.display = "none";
      }
    }
  });
</script>
